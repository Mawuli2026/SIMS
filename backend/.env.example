TEST_DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_SSL=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
